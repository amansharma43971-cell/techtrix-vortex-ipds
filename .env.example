# ==============================================================================
# BhandarSetu (Vortex iPDS) — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific secrets.
# NEVER commit the active '.env' file or production credentials to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=bhandarsetu
POSTGRES_USER=pds_admin
POSTGRES_PASSWORD=replace_with_strong_password_minimum_16_characters
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pds_admin:replace_with_strong_password_minimum_16_characters@postgres:5432/bhandarsetu

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
# Secure random salt and session secret (Generate using: openssl rand -hex 32)
JWT_SECRET=replace_with_64_char_cryptographically_secure_hex_key
SESSION_EXPIRY_HOURS=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=5

# ------------------------------------------------------------------------------
# 3. API & CORS Configuration
# ------------------------------------------------------------------------------
API_PORT=8000
API_HOST=0.0.0.0
# Comma-separated list of permitted origin domains
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 4. Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# Public API endpoint accessible by the client browser
VITE_API_BASE=http://localhost:8000

# ------------------------------------------------------------------------------
# 5. Background Notification Worker & SMTP (MailHog for Dev / SendGrid for Prod)
# ------------------------------------------------------------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=bhandarsetu-alerts@gov.in

